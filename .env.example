# Copy to backend/.env and fill in real values for your environment.
# Nothing in this file is a real secret.

# --- Database ---
# Default: local SQLite file, zero setup.
DATABASE_URL=sqlite:///./signbridge.db
# Postgres alternative (used by docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://signbridge:signbridge@localhost:5432/signbridge

# --- Auth ---
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- ML ---
RECOGNITION_MODEL_PATH=../ml/models/asl_landmark_classifier.joblib
RECOGNITION_CONFIDENCE_THRESHOLD=0.75

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
