server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_ssl_server_name on;
        # Deliberately NOT forwarding the original Host header: on a
        # shared-domain host like Render, that header is what the upstream's
        # own edge uses to route the request -- forwarding this service's
        # hostname instead of the backend's causes an actual routing loop
        # (seen as "508 Loop Detected"). Let nginx default to the upstream
        # host derived from proxy_pass instead.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback for client-side routing
    location / {
        try_files $uri /index.html;
    }
}
